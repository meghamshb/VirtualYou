FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
ARG BACKEND_EXTRAS=backend
RUN pip install --no-cache-dir ".[${BACKEND_EXTRAS}]" && useradd --uid 10001 --create-home appuser && mkdir /data && chown appuser /data
USER appuser
ENV VIRTUAL_YOU_DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8000
# CLI ingestion remains available with: docker run IMAGE virtual-you --help
CMD ["virtual-you-server", "serve", "--host", "0.0.0.0", "--port", "8000"]
