FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY slack_agent ./slack_agent
RUN pip install --no-cache-dir '.[hosted]' ./slack_agent && useradd --uid 10001 --create-home appuser && mkdir /data && chown appuser /data
USER appuser
ENV VY_HOSTED_DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8000
CMD ["uvicorn", "virtual_you.hosted.app:create_relay", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log", "--log-level", "critical"]
