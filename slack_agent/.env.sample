# One-time identity: restrict history, controls, and approvals to your account.
VIRTUAL_YOU_SLACK_OWNER=U_YOUR_MEMBER_ID
VIRTUAL_YOU_SLACK_TEAM=T_YOUR_WORKSPACE_ID

# OPTIONAL legacy Socket Mode only. Leave all three access-token fields blank for app_oauth.py.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
# Browser OAuth automatically obtains and stores the user token. Do not paste one for normal setup.
SLACK_USER_TOKEN=

# RECOMMENDED: operator config for browser OAuth / HTTP. Users click Connect Slack.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
PORT=3000

# Same absolute activity directory as Member 1; no raw editor logs are read here.
VIRTUAL_YOU_DATA_DIR=.virtual-you
# VIRTUAL_YOU_ACTIVITY_DIR=/absolute/path/to/ingestion/activities
VIRTUAL_YOU_HEARTBEAT_SECONDS=30
VIRTUAL_YOU_SLACK_POLL_SECONDS=30
VIRTUAL_YOU_DRAFT_QUIET_SECONDS=60
VIRTUAL_YOU_DRAFT_INTERVAL_SECONDS=600
VIRTUAL_YOU_REPORT_HOURS=24

# demo is offline/extractive; configure openai or ollama for actual language generation.
VIRTUAL_YOU_LLM_PROVIDER=demo
VIRTUAL_YOU_LLM_MODEL=
OPENAI_API_KEY=
VIRTUAL_YOU_OLLAMA_URL=http://127.0.0.1:11434
# False previews the complete workflow, without posting to the selected person.
# Review cards to YOUR bot DM still work when Slack is connected.
VIRTUAL_YOU_LIVE_DELIVERY=false
# Optional: channel/group reply transport only; unset inherits the value above.
# This never bypasses conversation scope or the configured approval mode.
# VIRTUAL_YOU_GROUP_LIVE_DELIVERY=true

# Optional explicit project source map; runs on the existing backend heartbeat.
VIRTUAL_YOU_INGESTION_CONFIG=

# Voice memos: text drafting still uses the configured LLM above.
# Install .[voice] for local transcription, or .[voice-cloud] for ElevenLabs.
VIRTUAL_YOU_VOICE_PROVIDER=local
VIRTUAL_YOU_VOICE_MODEL=small
VIRTUAL_YOU_VOICE_LANGUAGE=
# Required only when VIRTUAL_YOU_VOICE_PROVIDER=elevenlabs; raw audio is uploaded.
ELEVENLABS_API_KEY=
