# One-time identity: restrict history, controls, and approvals to your account.
VIRTUAL_YOU_SLACK_OWNER=U_YOUR_MEMBER_ID
VIRTUAL_YOU_SLACK_TEAM=T_YOUR_WORKSPACE_ID

# Socket Mode without slack run: copy the app-level connections:write token and bot token once.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
# Your user OAuth token needs im:read, im:history, users:read. NEVER use the bot token here.
# Leave empty when connecting through app_oauth.py's persisted OAuth installation.
SLACK_USER_TOKEN=

# Optional browser-based OAuth setup / hosted HTTP entry point.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
PORT=3000

# Same absolute activity directory as Member 1; no raw editor logs are read here.
VIRTUAL_YOU_DATA_DIR=.virtual-you
# VIRTUAL_YOU_ACTIVITY_DIR=/absolute/path/to/ingestion/activities
VIRTUAL_YOU_HEARTBEAT_SECONDS=30
VIRTUAL_YOU_SLACK_POLL_SECONDS=30
VIRTUAL_YOU_DRAFT_QUIET_SECONDS=60
VIRTUAL_YOU_DRAFT_INTERVAL_SECONDS=600
VIRTUAL_YOU_REPORT_HOURS=24

# demo is offline/extractive; configure openai or ollama for actual language generation.
VIRTUAL_YOU_LLM_PROVIDER=demo
VIRTUAL_YOU_LLM_MODEL=
OPENAI_API_KEY=
VIRTUAL_YOU_OLLAMA_URL=http://127.0.0.1:11434
# False previews the complete workflow, without posting to the selected person.
# Review cards to YOUR bot DM still work when Slack is connected.
VIRTUAL_YOU_LIVE_DELIVERY=false
