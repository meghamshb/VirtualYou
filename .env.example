# Use the SAME absolute directory for Member 1 ingestion and this backend.
# The backend defaults to .virtual-you in its working directory, not your home.
VIRTUAL_YOU_DATA_DIR=.virtual-you
# Optional: point at an existing Member 1 sanitized activities directory.
# VIRTUAL_YOU_ACTIVITY_DIR=/absolute/path/to/.virtual-you/activities

# Leave empty to generate a private admin.key file in the data directory.
# Use `virtual-you-server show-key` locally; never commit or paste the key into Git.
VIRTUAL_YOU_API_KEY=

# demo = explicitly labeled offline extractive mode. Use openai or ollama for LLMs.
VIRTUAL_YOU_LLM_PROVIDER=demo
# Required for openai / ollama: set an available model name.
VIRTUAL_YOU_LLM_MODEL=
OPENAI_API_KEY=
VIRTUAL_YOU_OLLAMA_URL=http://127.0.0.1:11434
VIRTUAL_YOU_REQUEST_TIMEOUT=60

VIRTUAL_YOU_HEARTBEAT_ENABLED=true
VIRTUAL_YOU_HEARTBEAT_SECONDS=30
VIRTUAL_YOU_STALE_HOURS=24
# Optional GET endpoint returning a JSON array of redacted ActivityRecords.
# HTTPS required except localhost. Redirects disabled. Incremental/upsert feed.
VIRTUAL_YOU_ACTIVITY_FEED_URL=
VIRTUAL_YOU_ACTIVITY_FEED_TOKEN=

# False uses simulation receipts; no Slack/Discord network calls.
VIRTUAL_YOU_LIVE_DELIVERY=false
SLACK_BOT_TOKEN=
# Comma-separated Slack conversation IDs the owner may approve delivery to.
VIRTUAL_YOU_SLACK_CHANNELS=
# Discord target is the alias "default", never a user-supplied webhook URL.
DISCORD_WEBHOOK_URL=

# GitHub (optional). Interns click Authorize GitHub; they do not paste a PAT or run github-ask.
# Create an OAuth App (or GitHub App) with a localhost callback:
#   http://127.0.0.1:8000/github/callback   (review UI)
#   http://127.0.0.1:8765/github/callback   (CLI: virtual-you github-auth)
VIRTUAL_YOU_MCP_GITHUB=false
VIRTUAL_YOU_GITHUB_REPO=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT=http://127.0.0.1:8000/github/callback
GITHUB_OAUTH_SCOPES=public_repo
# Optional operator override. Leave empty when using Authorize GitHub.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

VIRTUAL_YOU_MCP_JIRA=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

VIRTUAL_YOU_MCP_DRIVE=false
VIRTUAL_YOU_DRIVE_FOLDER_ID=
GOOGLE_ACCESS_TOKEN=
