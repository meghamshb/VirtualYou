{
  "name": "virtualyou-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VirtualYou desktop onboarding and review workspace",
  "author": "VirtualYou",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:electron": "node scripts/build-electron.mjs",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/check-customer.cases.mjs",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src shared electron tests",
    "format": "prettier --write src shared electron tests vite.config.ts",
    "test:electron": "npm run build && node scripts/smoke-electron.mjs",
    "build:collector": "node scripts/bundle-collector.mjs",
    "package:customer": "npm run check:customer && npm run build:collector && npm run build && electron-builder --mac --dir",
    "check:customer": "node scripts/customer-preflight.mjs",
    "release:customer": "node scripts/customer-preflight.mjs --release && npm run build:collector && npm run build && electron-builder --config electron-builder.customer.cjs --mac --publish never"
  },
  "build": {
    "appId": "com.virtualyou.desktop",
    "productName": "VirtualYou",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "service.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true
    },
    "asar": true,
    "extraResources": [
      {
        "from": "collector-dist/virtual-you-collector",
        "to": "collector",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.8",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
